# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-api-key-here

# Server port (optional, default: 3001)
PORT=3001

# OpenAI Realtime model (optional, default: gpt-4o-realtime-preview)
OPENAI_MODEL=gpt-4o-realtime-preview

# Custom system prompt (optional – overrides the built-in HUD assistant prompt)
# HUD_SYSTEM_PROMPT=You are a custom HUD assistant...
